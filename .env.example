# Single env file for the whole repo (scripts, contracts tooling and the web app).
# Copy to .env and fill in. Account names only. NEVER put private keys here:
# keys live in the local NEAR keychain (~/.near-credentials).

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Funder: pays for everything. ejecto.testnet was created by the NEAR faucet service.
# Top it up at https://near-faucet.io (named accounts only, small amounts per request).
FUNDER_ACCOUNT=ejecto.testnet

# Named accounts created from the funder by scripts (see docs/build-and-deploy.md)
MASTER_ACCOUNT=ejecto.testnet
FACTORY_ACCOUNT=coins.ejecto.testnet
PROTOCOL_ACCOUNT=fees.ejecto.testnet
OWNER_ACCOUNT=ejecto.testnet
DEMO_ACCOUNTS=ani.ejecto.testnet,budi.ejecto.testnet,cici.ejecto.testnet,whale.ejecto.testnet

# Web app (Next.js only exposes variables that start with NEXT_PUBLIC_; web/next.config.ts loads this file from the repo root)
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_FACTORY_ID=coins.ejecto.testnet
# Public URL of the hosted site (Vercel), used for absolute social preview links
NEXT_PUBLIC_SITE_URL=https://ejecto.vercel.app
